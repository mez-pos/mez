<resources>
    <!-- A platform theme: the app draws no native widgets, so neither
         AppCompat nor Material earns its place. Light only, so the WebView
         tells the screens prefers-color-scheme: light whatever the tablet's
         dark mode, and the parchment ground shows before the first page. -->
    <style name="Theme.Mez" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/parchment</item>
    </style>
</resources>
