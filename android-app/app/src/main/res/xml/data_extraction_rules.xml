<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the tablet, to the cloud or to a new tablet: the WebView's
     storage holds the device's pairing token (ADR-338). allowBackup="false"
     stops the cloud backup; these rules stop the device-to-device copy too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
