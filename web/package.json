{
  "name": "mez-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "terminal",
    "backoffice",
    "guest",
    "lint"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint terminal/src backoffice/src guest/src shared",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "size": "node scripts/check-size.mjs",
    "classes": "node scripts/check-classes.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "ts-api-utils": {
      "typescript": "5.9.3"
    }
  }
}
